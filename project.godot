; Tobi e Breu 3D — Godot 4 project
config_version=5

[application]
boot_splash/show_image=false
boot_splash/bg_color=Color(0.031, 0.043, 0.051, 1)
config/name="Tobi e Breu — Dark World 3D 0.12.2"
config/icon="res://assets/icons/tobi_breu_icon.svg"
run/main_scene="res://scenes/update_bootstrap.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
UpdateManager="*res://scripts/update_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.065, 1)

[physics]
3d/default_gravity=18.0

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
attack={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventJoypadButton,"button_index":2)]}
interact={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadButton,"button_index":0)]}
jump={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":3)]}
dodge={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventJoypadButton,"button_index":1)]}
potion={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":72),Object(InputEventJoypadButton,"button_index":4)]}
upgrade={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":85),Object(InputEventJoypadButton,"button_index":5)]}
shadow={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":75),Object(InputEventJoypadButton,"button_index":9)]}

[editor_plugins]
enabled=PackedStringArray("res://addons/dark_fantasy_asset_bridge/plugin.cfg")
